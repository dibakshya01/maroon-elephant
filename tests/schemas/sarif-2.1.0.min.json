{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["version", "runs"],
  "properties": {
    "version": {"const": "2.1.0"},
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["tool", "results"],
        "properties": {
          "tool": {
            "type": "object", "required": ["driver"],
            "properties": {"driver": {"type": "object", "required": ["name", "rules"]}}
          },
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["ruleId", "message", "locations", "partialFingerprints"],
              "properties": {
                "ruleId": {"type": "string"},
                "level": {"enum": ["error", "warning", "note", "none"]},
                "message": {"type": "object", "required": ["text"]},
                "locations": {"type": "array", "minItems": 1},
                "partialFingerprints": {"type": "object"}
              }
            }
          }
        }
      }
    }
  }
}
