{
  "id": "ME-LLM08-hardcoded-secret",
  "title": "Hard-coded secret / credential",
  "detector": "regex",
  "severity": "high",
  "confidence": "medium",
  "primary": "LLM08",
  "also": [
    "DSGAI02"
  ],
  "patterns": [
    {
      "pattern": "sk-[A-Za-z0-9]{20,}",
      "message": "Hard-coded API key (OpenAI-style)."
    },
    {
      "pattern": "AKIA[0-9A-Z]{16}",
      "message": "Hard-coded AWS access key id."
    },
    {
      "pattern": "(?i)(api[_-]?key|secret|token|password)\\s*[:=]\\s*[\\\"'][^\\\"'\\s]{12,}[\\\"']",
      "message": "Hard-coded credential literal (CWE-798)."
    }
  ],
  "exclude_if_line_matches": "(os\\.environ|getenv|process\\.env|vault|SecretStr|\\$\\{|<[A-Z_]+>|example|xxxx|placeholder|maroon:\\s*ignore)",
  "remediation": "Never hard-code secrets or place them in prompts/tool descriptions. Use a secrets manager/vault; keep secrets out of the model's context entirely."
}
